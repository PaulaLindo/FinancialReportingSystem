# ── Copy to .env for local runs. Never commit .env (see .gitignore).
# Secrets live only here and in Render Dashboard — not in NEXT_PUBLIC_* (Maroon) or Flask templates.

# Supabase — project URL & anon key (acceptable for authenticated server-side PostgREST; never expose service role below)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role JWT (RLS bypass) — server only. Dashboard → Settings → API → service_role
# Required on Render for period lock, inbox, asset register, admin mutations.
SUPABASE_SECRET_KEY=your_service_role_jwt_here

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-in-production-min-32-chars

# Maroon Traceability (Next.js) — deployed site ROOT only; no trailing slash.
# Paths like /intro are built in utils/integration_urls.maroon_intro_url().
# MAROON_APP_URL=https://maroontraceabilitydemo.vercel.app

# Optional SMTP (in-app inbox works without these)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true

# GRAP 17 asset journals — CFO escalation threshold (ZAR). Disposals always escalate.
# ASSET_JOURNAL_MATERIALITY_THRESHOLD=100000
