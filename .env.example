# Supabase Configuration - Anon Key Only (Recommended)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role JWT (RLS bypass) — Supabase Dashboard → Settings → API → service_role
SUPABASE_SECRET_KEY=your_service_role_jwt_here

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=varydian-demo-2025-secure-key-auth-enabled

# Required on Render (period lock, inbox, asset register, admin writes)
SUPABASE_SECRET_KEY=your_service_role_jwt_here

# Optional: For production
# FLASK_ENV=production
# SECRET_KEY=your_production_secret_key

# Maroon Traceability (Next.js) — for cross-app nav / deep links after deploy
# MAROON_APP_URL=https://maroontraceability.co.za

# Optional SMTP (in-app inbox still works without these)
# SMTP_HOST=smtp.example.com

# GRAP 17 asset journals — CFO escalation threshold (ZAR). Disposals always escalate.
# ASSET_JOURNAL_MATERIALITY_THRESHOLD=100000
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true
